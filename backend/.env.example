# Copy this file to .env and paste your keys. .env is git-ignored; never commit it or put keys in the app.
#
# Leave GROQ_API_KEY empty to run in FAKE mode: no calls leave your machine and every entry returns a sample card.

# Text LLM ("the brain") and Whisper speech-to-text
GROQ_API_KEY=

# Image recognition. Leave empty to use GROQ_API_KEY for photos too.
GROQ_VISION_API_KEY=

# Models, in order. When one reaches its Groq limit the next answers (limits are per model, same account).
TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
VISION_MODELS=qwen/qwen3.8-27b
STT_MODELS=whisper-large-v3,whisper-large-v3-turbo

# Limits
PHOTO_DAILY_CAP=4
MAX_TEXT_CHARS=2000
MAX_AUDIO_MB=20
MAX_IMAGE_MB=4
